# ==============================================================================
# SSUP Frontend — Docker Environment Configuration Template
# ==============================================================================
# Copy this file to .env.docker or .env in the frontend directory before running:
#   docker compose up -d --build
# ==============================================================================

# External port on host for the frontend web application
FRONTEND_PORT=3000

# Backend API Base URL
# - Leave empty ("") if using the Nginx reverse-proxy on the same domain (Recommended - Zero CORS)
# - Set to full URL (e.g. "https://api.schoolsuppro.com") if backend is hosted on a different domain
VITE_API_BASE_URL=

# Backend API Version Prefix
VITE_API_VERSION=/api/v1

# Multi-Tenant Header Name
VITE_TENANT_HEADER_NAME=X-Tenant-ID

# Application Name
VITE_APP_NAME=Schools Up Pro
