# ==============================================================================
# Schools Up Pro — Frontend Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# Note: Only variables prefixed with VITE_ are accessible to the browser bundle.
# ==============================================================================

# Backend FastAPI Base URL
VITE_API_BASE_URL=http://localhost:8000

# Backend API Version Prefix
VITE_API_VERSION=/api/v1

# Header Name for Multi-Tenant Context Resolution
VITE_TENANT_HEADER_NAME=X-Tenant-ID

# Application Display Name
VITE_APP_NAME=Schools Up Pro
